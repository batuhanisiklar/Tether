# Remote Phone Control environment template
# Copy values into your deployment environment or local env loader.
# Do not commit real secret values.

# Server
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SEC=86400
PORT=8765

# Local-only fallback for throwaway development without AUTH_SECRET:
# APP_ENV=local
# ALLOW_DEV_AUTH_SECRET=1

# Desktop optional override
RPC_SERVER_URL=wss://your-signaling-host.example.com
