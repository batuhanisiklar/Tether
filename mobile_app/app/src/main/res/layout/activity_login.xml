<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="🔗"
            android:textSize="32sp"
            android:gravity="center"
            android:contentDescription="@string/login_icon"
            android:background="@drawable/login_icon_bg"
            android:layout_marginBottom="20dp" />

        <TextView
            style="@style/TextRemoteControlTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:layout_marginBottom="6dp" />

        <TextView
            style="@style/TextRemoteControlBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/TextRemoteControlCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_helper"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/login_card_bg"
            android:orientation="vertical"
            android:elevation="0dp"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_username_label"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/login_username_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:background="@drawable/login_input_bg"
                android:paddingHorizontal="14dp"
                android:imeOptions="actionNext"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_password_label"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:background="@drawable/login_input_bg"
                android:paddingHorizontal="14dp"
                android:imeOptions="actionDone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_login_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/danger"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <Button
                style="@style/WidgetRemoteControlPrimaryButton"
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:text="@string/login_button"
                android:layout_marginTop="6dp" />

            <Button
                style="@style/WidgetRemoteControlSecondaryButton"
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:text="@string/register_button"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <TextView
            style="@style/TextRemoteControlCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_footer"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
