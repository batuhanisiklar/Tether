<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/iv_login_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/login_icon"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:background="@drawable/login_icon_bg"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

        <TextView
            style="@style/TextRemoteControlTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:layout_marginBottom="6dp" />

        <TextView
            style="@style/TextRemoteControlBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/login_card_bg"
            android:orientation="vertical"
            android:elevation="0dp"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Kayıt: Ad | Soyad yan yana -->
            <LinearLayout
                android:id="@+id/register_fields_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        style="@style/TextRemoteControlFieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/login_first_name_label" />

                    <TextView
                        style="@style/TextRemoteControlFieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/login_last_name_label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_first_name"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="@string/login_first_name_hint"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/login_input_bg"
                        android:paddingHorizontal="12dp"
                        android:imeOptions="actionNext" />

                    <EditText
                        android:id="@+id/et_last_name"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:hint="@string/login_last_name_hint"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/login_input_bg"
                        android:paddingHorizontal="12dp"
                        android:imeOptions="actionNext" />
                </LinearLayout>
            </LinearLayout>

            <!-- E-posta | Telefon: kayıtta yan yana; girişte yalnızca e-posta (telefon sütunu gizli) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRemoteControlFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_email_label"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/login_email_hint"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/login_input_bg"
                        android:paddingHorizontal="12dp"
                        android:imeOptions="actionNext" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/phone_block"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextRemoteControlFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_phone_label"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/login_phone_hint"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/login_input_bg"
                        android:paddingHorizontal="12dp"
                        android:imeOptions="actionNext" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_password_label"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/login_password_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:background="@drawable/login_input_bg"
                    android:paddingHorizontal="14dp"
                    android:imeOptions="actionNext" />

                <ImageButton
                    android:id="@+id/btn_toggle_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/login_input_bg"
                    android:contentDescription="@string/toggle_password_visibility"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_visibility" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chk_remember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_remember_me"
                android:textColor="@color/text_secondary"
                android:buttonTint="@color/primary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/label_password_confirm"
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_password_confirm_label"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/password_confirm_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/et_password_confirm"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/login_password_confirm_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:background="@drawable/login_input_bg"
                    android:paddingHorizontal="14dp"
                    android:imeOptions="actionDone" />

                <ImageButton
                    android:id="@+id/btn_toggle_password_confirm"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/login_input_bg"
                    android:contentDescription="@string/toggle_password_visibility"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_visibility" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_login_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/danger"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <Button
                style="@style/WidgetRemoteControlPrimaryButton"
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:text="@string/login_button"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_auth_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_switch_to_register"
                android:textSize="13sp"
                android:textColor="@color/primary"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            style="@style/TextRemoteControlCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_footer"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
