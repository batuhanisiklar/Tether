<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_dialog_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/card_soft_bg"
            android:contentDescription="@string/app_name"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/primary" />

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingMultiplier="1.18"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            style="@style/WidgetRemoteControlSecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_dialog_positive"
            style="@style/WidgetRemoteControlPrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
