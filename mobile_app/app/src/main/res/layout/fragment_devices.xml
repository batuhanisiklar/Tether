<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app"
    android:paddingHorizontal="@dimen/page_padding_h"
    android:paddingTop="@dimen/page_padding_top"
    android:paddingBottom="@dimen/page_padding_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Baslik -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_soft_bg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/section_gap">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paired_devices_title"
                android:layout_marginBottom="@dimen/item_gap" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devices_page_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bos Durum -->
        <LinearLayout
            android:id="@+id/tv_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_soft_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="@dimen/card_padding_large"
            android:paddingVertical="@dimen/card_padding_large">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱"
                android:textSize="30sp"
                android:layout_marginBottom="@dimen/item_gap" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paired_devices_empty"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_code_help"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="@dimen/item_gap" />
        </LinearLayout>

        <!-- Cihaz Listesi -->
        <LinearLayout
            android:id="@+id/layout_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
