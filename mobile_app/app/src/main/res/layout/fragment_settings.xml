<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/page_padding_h"
    android:paddingTop="@dimen/page_padding_top"
    android:paddingBottom="@dimen/page_padding_bottom_large"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/profile_header_card_bg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_large">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_profile_title"
                android:layout_marginBottom="4dp" />

            <TextView
                style="@style/TextRemoteControlCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_profile_subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_profile_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/profile_avatar_bg"
                    android:gravity="center"
                    android:textColor="@color/text_inverse"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_profile_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_profile_edit"
                style="@style/WidgetRemoteControlSecondaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/settings_profile_edit"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_profile_change_password"
                style="@style/WidgetRemoteControlSecondaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/settings_profile_password_section"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tv_profile_header_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_profile_edit_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/profile_edit_panel_bg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_profile_edit_section"
                android:layout_marginBottom="12dp" />

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_first_name_label"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_readonly_full_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:background="@drawable/login_input_bg"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/TextRemoteControlCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_profile_name_locked" />

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_email_label"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_profile_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/login_input_bg"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_phone_label"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_profile_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/login_input_bg"
                android:hint="@string/login_phone_label"
                android:inputType="phone"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_profile_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_profile_cancel"
                    style="@style/WidgetRemoteControlSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/settings_profile_cancel"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_profile_save"
                    style="@style/WidgetRemoteControlPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_profile_save"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_profile_password_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/profile_edit_panel_bg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_profile_password_section"
                android:layout_marginBottom="12dp" />

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mevcut şifre"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_profile_old_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/login_input_bg"
                android:hint="Mevcut şifreniz"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yeni şifre"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_profile_new_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/login_input_bg"
                android:hint="Yeni şifre"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <TextView
                style="@style/TextRemoteControlFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yeni şifre (tekrar)"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_profile_new_password2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/login_input_bg"
                android:hint="Yeni şifre (tekrar)"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_profile_password_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_profile_password_cancel"
                    style="@style/WidgetRemoteControlSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/settings_profile_cancel"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_profile_password_save"
                    style="@style/WidgetRemoteControlPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_profile_save"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/card_soft_bg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_title"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_device_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_paired_pc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_logout"
            style="@style/WidgetRemoteControlSecondaryButton"
            android:layout_width="match_parent"
            android:text="@string/logout"
            android:textAllCaps="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
