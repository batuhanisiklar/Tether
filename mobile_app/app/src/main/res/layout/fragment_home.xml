<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app"
    android:paddingHorizontal="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Kullanici Bilgisi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_soft_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/success" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    style="@style/TextRemoteControlSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_account_title"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sabit Adres -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_accent_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="28dp"
            android:layout_marginBottom="14dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_code_title"
                android:textColor="@color/primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_code_placeholder"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:singleLine="true"
                android:scrollHorizontally="false"
                android:ellipsize="none" />

            <TextView
                style="@style/TextRemoteControlCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_code_help"
                android:layout_marginTop="12dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Durum -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_soft_bg"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_title"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_initializing"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Hizli Islemler -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_soft_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_quick_actions_title"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_connect"
                style="@style/WidgetRemoteControlPrimaryButton"
                android:layout_width="match_parent"
                android:text="@string/retry_connect"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_stop_stream"
                style="@style/WidgetRemoteControlDangerButton"
                android:layout_width="match_parent"
                android:text="@string/stop_stream" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
