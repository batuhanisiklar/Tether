<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/page_padding_h"
    android:paddingTop="@dimen/page_padding_top"
    android:paddingBottom="@dimen/page_padding_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/home_hero_bg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_large">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_home"
                    android:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/home_greeting_label"
                    android:textAllCaps="true"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/home_hero_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/home_code_inner_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/card_padding"
                android:paddingVertical="@dimen/card_padding">

                <TextView
                    style="@style/TextRemoteControlSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/connection_code_title"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tv_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:scrollHorizontally="false"
                    android:singleLine="true"
                    android:text="@string/connection_code_placeholder"
                    android:textColor="@color/primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_home_copy_code"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/copy"
                        android:padding="10dp"
                        android:src="@drawable/ic_copy"
                        android:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/btn_home_share_code"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/share"
                        android:padding="10dp"
                        android:src="@drawable/ic_share"
                        android:tint="@color/text_primary" />
                </LinearLayout>

                <TextView
                    style="@style/TextRemoteControlCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/connection_code_help" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_home_accessibility_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/card_warning_bg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/home_accessibility_section_title" />

            <TextView
                android:id="@+id/tv_home_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/warning"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_home_accessibility_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_home_accessibility_steps_title"
                    style="@style/TextRemoteControlSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/home_accessibility_steps_title" />

                <TextView
                    android:id="@+id/tv_home_accessibility_step_1"
                    style="@style/TextRemoteControlCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/home_accessibility_step_1" />

                <TextView
                    android:id="@+id/tv_home_accessibility_step_2"
                    style="@style/TextRemoteControlCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/home_accessibility_step_2" />

                <TextView
                    android:id="@+id/tv_home_accessibility_step_3"
                    style="@style/TextRemoteControlCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/home_accessibility_step_3" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_home_accessibility"
                style="@style/WidgetRemoteControlSecondaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/open_accessibility_settings"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:minHeight="180dp"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_recent_events_title" />

            <TextView
                android:id="@+id/tv_home_event_1"
                style="@style/TextRemoteControlBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/tv_home_event_2"
                style="@style/TextRemoteControlBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/tv_home_event_3"
                style="@style/TextRemoteControlBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/tv_home_event_4"
                style="@style/TextRemoteControlBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/tv_home_event_5"
                style="@style/TextRemoteControlBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
