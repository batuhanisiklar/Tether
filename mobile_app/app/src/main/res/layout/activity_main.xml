<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo / Başlık -->
        <TextView
            style="@style/TextRemoteControlTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/TextRemoteControlBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_user_prefix"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PC / Sunucu adresi (aynı ağdaki bilgisayar IP'si) - Gizlendi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_ip_label"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_server_ip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/server_ip_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:imeOptions="actionDone" />
        </LinearLayout>

        <!-- Bağlantı Kodu Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_code_title"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_code_placeholder"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.3"
                android:fontFamily="monospace" />

            <TextView
                style="@style/TextRemoteControlBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_code_help"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Durum Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_title"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_initializing"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_ip_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/TextRemoteControlSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paired_devices_title"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_paired_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/paired_devices_empty"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Erişilebilirlik Uyarısı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_warning_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/warning_accessibility"
                android:textSize="13sp"
                android:textColor="@color/warning"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Butonlar -->
        <Button
            style="@style/WidgetRemoteControlPrimaryButton"
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:text="@string/retry_connect"
            android:layout_marginBottom="10dp" />

        <Button
            style="@style/WidgetRemoteControlDangerButton"
            android:id="@+id/btn_stop_stream"
            android:layout_width="match_parent"
            android:text="@string/stop_stream"
            android:layout_marginBottom="10dp" />

        <Button
            style="@style/WidgetRemoteControlSecondaryButton"
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:text="@string/logout"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
