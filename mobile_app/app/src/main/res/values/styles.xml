<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextRemoteControlTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextRemoteControlBody">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextRemoteControlSectionLabel">
        <item name="android:textSize">@dimen/text_section_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextRemoteControlFieldLabel">
        <item name="android:textSize">@dimen/text_field_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextRemoteControlValue">
        <item name="android:textSize">@dimen/text_value</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextRemoteControlCaption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="WidgetRemoteControlPrimaryButton">
        <item name="android:layout_height">@dimen/button_primary_height</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">@dimen/text_button_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="WidgetRemoteControlDangerButton">
        <item name="android:layout_height">@dimen/button_primary_height</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">@dimen/text_button_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/danger</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="WidgetRemoteControlSecondaryButton">
        <item name="android:layout_height">@dimen/button_secondary_height</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_button_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/surface_tint</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>
</resources>
