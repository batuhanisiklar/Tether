<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.RemoteControl.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.RemoteControl.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.RemoteControl.SectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.RemoteControl.FieldLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Text.RemoteControl.Value">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.RemoteControl.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="Widget.RemoteControl.PrimaryButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/primary</item>
    </style>

    <style name="Widget.RemoteControl.DangerButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/danger</item>
    </style>
</resources>
